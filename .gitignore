# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# загруженные администратором файлы
/public/uploads/*
!/public/uploads/.gitkeep
# файл используется в уроке — без него на сайте будет битая картинка
!/public/uploads/c18b88b69bea42abc8175f93.jpg

# отдельная папка сборки для проверок
/.next-verify/

# исходники учебников и медиа: в репозиторий не идут, на сайт попадает
# только то, что скопировано в public/
/books/
/video/
/audio/
/photos/
/oge/
